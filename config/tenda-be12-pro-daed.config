# FanchmWrt-snapshot Tenda BE12 Pro + daed 专用配置
# 目标: mediatek/filogic/tenda_be12-pro (或 mediatek/mt7986, 视具体源码分支定义为准)
# 用法: 工作流会自动 cp 到 openwrt/.config 然后 make defconfig
# 本地验证: cp config/tenda-be12-pro-daed.config openwrt/.config && make defconfig

# ===== Target =====
#CONFIG_TARGET_mediatek=y
#CONFIG_TARGET_DEVICE_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tenda_be12-pro=y

# 提示：如果是 hanwckf 等老源码分支，请取消下面两行的注释，并注释掉上面对应的两行：
# CONFIG_TARGET_mediatek_mt7986=y
# CONFIG_TARGET_mediatek_mt7986_DEVICE_tenda_be12-pro=y

# 仅编译这一个机型
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ===== 闪存分区大小限制 (针对 Tenda BE12 Pro 128MB SPI-NAND 优化) =====
# 物理 UBI 空间约 90MB，这里切回安全上限（85MB），防止插件积攒过多导致超出硬件物理总线限制
CONFIG_TARGET_ROOTFS_PARTSIZE=85
CONFIG_TARGET_KERNEL_PARTSIZE=6

# ===== 内核 eBPF/BTF (dae/daed 必需) =====
# dae Makefile 要求: KERNEL_DEBUG_INFO_BTF + KERNEL_BPF_EVENTS
# daed 要求: KERNEL_XDP_SOCKETS
# 注意: KERNEL_DEBUG_INFO_REDUCED 默认 y, 会卡掉 BTF (depends on !REDUCED), 必须显式关掉
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y

# ===== 开发者选项 (必须, 否则 BPF_TOOLCHAIN 选择题 prompt 不可见,
#      Kconfig 会忽略 .config 里写的 BPF_TOOLCHAIN_HOST=y 强制回落默认值) =====
CONFIG_DEVEL=y

# ===== BPF 工具链 (dae 编译 eBPF 必需, 否则报 /invalid/clang) =====
# OpenWrt 默认 BPF_TOOLCHAIN_BUILD_LLVM 在 defconfig 下经常落空导致
# LLVM_PATH=/invalid, 用主机 clang (工作流已 apt 安装 clang-14) 最稳最快
# 依赖 CONFIG_DEVEL=y 才能生效 (见上)
CONFIG_BPF_TOOLCHAIN_HOST=y

# ===== dae / daed 主体 (kenzok8/openwrt-daede 源) =====
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
# kenzok8 源里的 LuCI 叫 luci-app-daede (多一个 e), QiuSimons 源叫 luci-app-daed
# 两个都写上, 哪个存在哪个生效, 不存在的会被 defconfig 丢掉
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daede-zh-cn=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# BTF 兜底: 如果内核 BTF 没编进去, 用 vmlinux-btf 包
CONFIG_PACKAGE_vmlinux-btf=m

# ===== dae/daed 运行时依赖 =====
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# ===== 基础体验 (保留官方默认习惯) =====
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ===== 文件系统 / 工具 (128MB 闪存按需保留) =====
# 如果不接外部 USB 存储，可以不勾选以下几项以进一步节约 1-2MB 空间
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y
